# =============================================================================
# TenantRAG - Multi-Tenant RAG Microservice Configuration
# =============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_LANG=en

# =============================================================================
# 🧠 LLM CONFIGURATION - DEEPSEEK V3.1
# =============================================================================
LLM_PROVIDER=openrouter

# 🎯 Grok-4-fast - سریع و قدرتمند!
LLM_MODEL=x-ai/grok-4-fast:free

# تنظیمات بهینه برای بهترین خروجی
# LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60.0

# کلید API OpenRouter
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
LLM_BASE_URL=https://openrouter.ai/api/v1

# Hugging Face Local (اختیاری)
LLM_HF_MODEL=
LLM_HF_DEVICE=cpu

# =============================================================================
# 🔍 EMBEDDING CONFIGURATION - بهینه شده
# =============================================================================
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL=intfloat/e5-small-v2
EMBED_BATCH_SIZE=100
EMBED_TIMEOUT=20.0

# =============================================================================
# 📚 MULTI-FORMAT HTML SETTINGS
# =============================================================================
MULTI_FORMAT_HTML_EXTRACT_LINKS=true
MULTI_FORMAT_HTML_EXTRACT_IMAGES=true
MULTI_FORMAT_HTML_CLEAN_CONTENT=true
MULTI_FORMAT_HTML_TIMEOUT=20.0
MULTI_FORMAT_HTML_RETRIES=2
MULTI_FORMAT_HTML_EXTRACTOR=simple
MULTI_FORMAT_HTML_ENABLE_STRUCTURAL_EXTRACTION=true
MULTI_FORMAT_HTML_INJECT_HEADING_MARKERS=true
MULTI_FORMAT_HTML_DETECT_LANGUAGE=true
MULTI_FORMAT_HTML_USER_AGENT=ragbot-html-loader/1.0 (+https://github.com)
MULTI_FORMAT_HTML_USER_AGENT_MODE=fixed
MULTI_FORMAT_HTML_CUSTOM_HEADERS=
MULTI_FORMAT_HTML_COOKIES=
MULTI_FORMAT_HTML_MAX_LINKS=200
MULTI_FORMAT_HTML_MAX_IMAGES=200

# =============================================================================
# 📚 RAG SYSTEM CONFIGURATION - بهینه برای DeepSeek
# =============================================================================
# تنظیمات بهینه برای بهترین کیفیت
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50
RAG_MAX_CHUNKS_PER_DOCUMENT=500

# تنظیمات retrieval بهینه
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# OCR غیرفعال
RAG_OCR_ENABLED=false
RAG_OCR_ENGINE=none
RAG_OCR_LANG=eng
RAG_GOOGLE_TOKEN_PATH=

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================
VECTOR_DB=faiss
DATABASE_URL=sqlite:///./data/ragbot.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# 🚀 REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=3.0

# =============================================================================
# 🚀 CACHING CONFIGURATION
# =============================================================================
ENABLE_REDIS=true
CACHE_TTL=1800

# =============================================================================
# 🔒 SECURITY CONFIGURATION
# =============================================================================
SECURITY_MAX_FILE_SIZE_MB=25
SECURITY_ALLOWED_FILE_TYPES=["pdf","txt","docx"]
SECURITY_RATE_LIMIT_REQUESTS=20
SECURITY_RATE_LIMIT_WINDOW=60
SECURITY_ENABLE_USER_ALLOWLIST=true

# =============================================================================
# 📊 MONITORING CONFIGURATION
# =============================================================================
MONITORING_ENABLE_METRICS=true
MONITORING_METRICS_PORT=8080
MONITORING_HEALTH_CHECK_INTERVAL=30
MONITORING_LOG_LEVEL=DEBUG #INFO

# =============================================================================
# 📁 FILE PATHS CONFIGURATION
# =============================================================================
DATA_DIR=./data
STORE_PATH=./data/vector_store

# Vector Store Paths (automatically derived from STORE_PATH)
STORE_CHROMA_PERSIST_DIRECTORY=./data/vector_store/chroma
STORE_QDRANT_PATH=./data/vector_store/qdrant

LOG_FILE=./logs/ragbot.log

# =============================================================================
# 🏢 MULTI-TENANCY CONFIGURATION
# =============================================================================
# Set to true to enforce tenant isolation and API key authentication
MULTI_TENANT_ENABLED=true
MULTI_TENANT_ISOLATION_ENABLED=true
MULTI_TENANT_AUDIT_LOGGING=true
MULTI_TENANT_DATA_DIR=./data/tenants

# =============================================================================
# 🛠️ DEVELOPMENT CONFIGURATION
# =============================================================================
DEBUG=true

# =============================================================================
# 🔑 API KEYS (اختیاری)
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# 💡 OPTIMIZED CONFIGURATION ADVANTAGES
# =============================================================================
# ✅ Grok-4-fast: سریع‌تر و قدرتمندتر
# ✅ e5-small-v2: دقیق‌تر برای retrieval
# ✅ Caching فعال: Redis + Memory cache
# ✅ Timeout بهینه: 60s برای LLM
# ✅ Batch size بیشتر: 100 برای embeddings
# ✅ Chunk size بهینه: 400 برای کیفیت بهتر
# ✅ Top-K کمتر: 3 برای پاسخ‌های دقیق‌تر

# =============================================================================
# 🚨 IMPORTANT NOTES FOR DEEPSEEK
# =============================================================================
# 1. DeepSeek V3.1 رایگان است اما محدودیت 1M tokens/روز دارد
# 2. برای استفاده تجاری، ممکن است نیاز به پرداخت باشد
# 3. مدل عالی برای پاسخ‌های طولانی و پیچیده
# 4. پشتیبانی عالی از فارسی و انگلیسی
# 5. قابلیت تولید کد و استدلال قوی
# =============================================================================
