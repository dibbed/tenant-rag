class _ActiveTenants:
    """Fake tenant registry: the listed tenants exist and are active (Security C7, C8)."""

    def __init__(self, *tenant_ids: str) -> None:
        self._tenants = {
            tenant_id: TenantConfig(tenant_id=tenant_id, name=tenant_id) for tenant_id in tenant_ids
        }

    async def get_tenant(self, tenant_id: str):
        return self._tenants.get(tenant_id)


@pytest.fixture
def mock_integration_service():
@@@@END

@@@@OLD
    mock_rag.reset_store = AsyncMock(return_value=True)
    return mock_rag
@@@@NEW
    mock_rag.reset_store = AsyncMock(return_value=True)
    # Security (C7, C8): the tenant check needs an answer from the tenant
    # registry; an automatic MagicMock attribute is refused.
    mock_rag.tenant_manager = _ActiveTenants("acme_tenant_99")
    return mock_rag
