        """Return True when the condition holds; an unsupported condition never fires.

        Security (Bandit B307): the condition is parsed and evaluated by
        evaluate_condition; metric values are compared as numbers and are
        never put into code.
        """
        try:
            return evaluate_condition(condition, threshold, metrics)
        except UnsupportedConditionError as exc:
            _log.warning("Alert condition %r was not evaluated: %s", condition, exc)
            return False
