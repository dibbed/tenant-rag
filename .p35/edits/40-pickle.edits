@@@@FILE ragbot/caching/redis_cache.py
@@@@OLD
import json
import pickle
from typing import Any, Dict, List, Optional

from ragbot.caching.base import BaseCache
@@@@NEW
from typing import Any, Dict, List, Optional
from urllib.parse import urlsplit

from ragbot.caching.base import BaseCache
from ragbot.caching.cache_codec import decode_cache_value, encode_cache_value
@@@@END

@@@@OLD
class RedisCache(BaseCache):
    """
    Redis cache implementation with connection pooling and serialization.
    
    This cache uses Redis as the backend storage with automatic serialization
    and deserialization of Python objects.
    """
    
    def __init__(self, redis_url: Optional[str] = None, default_ttl: int = 3600, 
                 serialization: str = "pickle"):
        """
        Initialize the Redis cache.
        
        Args:
            redis_url: Redis connection URL (uses settings if None)
            default_ttl: Default time-to-live in seconds
            serialization: Serialization method ("pickle" or "json")
        """
        super().__init__(default_ttl)
        self.redis_url = redis_url or settings.redis.url
        self.serialization = serialization
        self._redis = None
        self._connection_pool = None
        
        logger.info(f"RedisCache initialized with URL={self.redis_url}, serialization={serialization}")
@@@@NEW
def _redacted_url(url: str) -> str:
    """Return the Redis URL without its password, for logs."""
    try:
        password = urlsplit(url).password
    except ValueError:
        return "<invalid Redis URL>"
    return url.replace(f":{password}@", ":***@", 1) if password else url


class RedisCache(BaseCache):
    """
    Redis cache implementation with connection pooling and serialization.

    Values are stored as versioned JSON (ragbot/caching/cache_codec.py).
    Security (Bandit B301): pickle is not used, because a writer with access to
    the Redis database could otherwise run code in the application. Legacy
    pickle entries and malformed entries are cache misses.
    """

    def __init__(self, redis_url: Optional[str] = None, default_ttl: int = 3600,
                 serialization: str = "json"):
        """
        Initialize the Redis cache.

        Args:
            redis_url: Redis connection URL (uses settings if None)
            default_ttl: Default time-to-live in seconds
            serialization: Must be "json" (the default). "pickle" was removed
                for security and raises ValueError.
        """
        if serialization != "json":
            raise ValueError(
                f"Unsupported cache serialization {serialization!r}: only 'json' is "
                "supported (pickle was removed because unpickling can run code)"
            )
        super().__init__(default_ttl)
        self.redis_url = redis_url or settings.redis.url
        self.serialization = serialization
        self._redis = None
        self._connection_pool = None

        logger.info(
            f"RedisCache initialized with URL={_redacted_url(self.redis_url)}, "
            f"serialization={serialization}"
        )
@@@@END

