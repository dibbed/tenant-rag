@@@@FILE ragbot/rag/embeddings/base.py
@@@@OLD
        return hashlib.md5(key_string.encode()).hexdigest()
@@@@NEW
        # Security: SHA-256, because an embedding cache can be shared by every
        # tenant and MD5 collisions are practical.
        return hashlib.sha256(key_string.encode("utf-8")).hexdigest()
@@@@END

@@@@FILE ragbot/rag/embeddings/st_embedder.py
@@@@OLD
from ragbot.rag.exceptions import EmbeddingError
@@@@NEW
from ragbot.rag.exceptions import EmbeddingError


def _embedding_cache_key(text: str) -> str:
    """Return the key of a text in the in-memory embedding cache.

    Security: SHA-256, because one embedder instance serves every tenant; with
    MD5, a crafted text could collide with another text and receive its cached
    embedding.
    """
    return hashlib.sha256(text.encode("utf-8")).hexdigest()
@@@@END

@@@@OLD count=4
hashlib.md5(text.encode()).hexdigest()
@@@@NEW
_embedding_cache_key(text)
@@@@END

