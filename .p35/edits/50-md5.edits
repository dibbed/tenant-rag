# Phase 3.5: Bandit B324 (MD5). Security-sensitive uses move to SHA-256; stable
# non-security identifiers keep MD5 with usedforsecurity=False.

@@@@FILE ragbot/caching/base.py
@@@@OLD
        text_hash = hashlib.md5(text.encode()).hexdigest()
@@@@NEW
        # Security: SHA-256. These keys name entries of a cache that every
        # tenant shares; with MD5, a crafted text could collide with another
        # text and receive its cached value.
        text_hash = hashlib.sha256(text.encode("utf-8")).hexdigest()
@@@@END

@@@@OLD
        question_hash = hashlib.md5(question.encode()).hexdigest()
@@@@NEW
        question_hash = hashlib.sha256(question.encode("utf-8")).hexdigest()  # see embedding()
@@@@END

@@@@OLD
        source_hash = hashlib.md5(source.encode()).hexdigest()
@@@@NEW
        source_hash = hashlib.sha256(source.encode("utf-8")).hexdigest()  # see embedding()
@@@@END

@@@@FILE ragbot/caching/semantic_cache.py
@@@@OLD
        query_hash = hashlib.md5(query.encode()).hexdigest()
@@@@NEW
        # Security: SHA-256, because this embedding cache is shared by every
        # tenant; with MD5, a crafted query could collide with another query
        # and receive its cached embedding.
        query_hash = hashlib.sha256(query.encode("utf-8")).hexdigest()
@@@@END

@@@@OLD
                h = int(hashlib.md5(query.encode()).hexdigest()[:8], 16)
@@@@NEW
                # Only the seed of a deterministic fallback vector, not a security
                # value: MD5 with usedforsecurity=False keeps the old vectors.
                h = int(hashlib.md5(query.encode(), usedforsecurity=False).hexdigest()[:8], 16)
@@@@END

@@@@FILE ragbot/plugins/plugin_marketplace.py
@@@@OLD
    async def _cache_search_results(
@@@@NEW
    def _search_cache_file(self, query: str) -> Path:
        """Return the cache file of the search results of one query.

        Security: the name is the SHA-256 of the query, so two different queries
        cannot be crafted to share one cache file (MD5 collisions are
        practical). Writing and reading use this one function.
        """
        digest = hashlib.sha256(query.encode("utf-8")).hexdigest()
        return self.cache_dir / f"search_{digest}.json"

    async def _cache_search_results(
@@@@END

@@@@OLD
            cache_file = (
                self.cache_dir
                / f"search_{hashlib.md5(query.encode()).hexdigest()}.json"
            )
@@@@NEW
            cache_file = self._search_cache_file(query)
@@@@END

@@@@OLD
            cache_file = (
                self.cache_dir
                / f"search_{hashlib.md5(query.encode()).hexdigest():.json}"
            )
@@@@NEW
            cache_file = self._search_cache_file(query)
@@@@END

