@@@@OLD
        hash_obj = hashlib.md5(f"{text}_{i}".encode())
@@@@NEW
        # Deterministic test and fallback vector, not a security value: MD5
        # (usedforsecurity=False) keeps the vectors that stores already hold.
        hash_obj = hashlib.md5(f"{text}_{i}".encode(), usedforsecurity=False)
@@@@END

