# Safe test-only environment template. Copy to .env.test for local pytest runs.
# Do not use real API keys or bot tokens in this file.

TESTING=true
ENABLE_REDIS=false
LOG_LEVEL=WARNING
BOT_TOKEN=123:test
OPENROUTER_API_KEY=sk-test-fake-key-not-real
OPENAI_API_KEY=sk-test-fake-openai-not-real
ANTHROPIC_API_KEY=sk-test-fake-anthropic-not-real
ALLOW_USERS=
DEFAULT_LANG=en
LLM_PROVIDER=openrouter
LLM_MODEL=test-model
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL=intfloat/e5-small-v2
VECTOR_DB=faiss
DATA_DIR=./data/test
STORE_PATH=./data/test/vector_store
DATABASE_URL=sqlite:///:memory:
REDIS_URL=redis://127.0.0.1:6379/0
