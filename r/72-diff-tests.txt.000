+from ragbot.multi_tenant.models import AuthenticatedPrincipal, TenantConfig
 from ragbot.services.rag_service import IngestResult, QueryResult
 
 
+class _ActiveTenants:
+    """Fake tenant registry: the listed tenants exist and are active (Security C7, C8)."""
+
+    def __init__(self, *tenant_ids: str) -> None:
+        self._tenants = {
+            tenant_id: TenantConfig(tenant_id=tenant_id, name=tenant_id) for tenant_id in tenant_ids
+        }
+
+    async def get_tenant(self, tenant_id: str):
+        return self._tenants.get(tenant_id)
+
+
 @pytest.fixture
