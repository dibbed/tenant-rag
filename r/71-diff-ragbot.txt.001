 from __future__ import annotations
 
+import ast
+import logging
+import numbers
+import operator
 from dataclasses import dataclass
 from datetime import datetime
-from typing import Any, Dict
+from typing import Any, Callable, Dict, Mapping
+
+_log = logging.getLogger(__name__)
+
+# Security (Bandit B307): an alert condition is parsed into a checked syntax
+# tree and evaluated by this module; it is never passed to eval(). Grammar:
+# comparisons (>, >=, <, <=, ==, !=) between metric names, ``threshold`` and
+# numbers, joined with ``and`` / ``or``.
+MAX_CONDITION_LENGTH = 200
+_COMPARISONS: Dict[type, Callable[[Any, Any], bool]] = {
+    ast.Gt: operator.gt,
+    ast.GtE: operator.ge,
+    ast.Lt: operator.lt,
+    ast.LtE: operator.le,
+    ast.Eq: operator.eq,
+    ast.NotEq: operator.ne,
+}
+
+
+class UnsupportedConditionError(ValueError):
+    """An alert condition is outside the supported grammar, or a value is not a number."""
+
+
+class _MissingMetric(LookupError):
+    """The condition names a metric that is not in the metrics."""
+
+
+def parse_condition(condition: str) -> ast.expr:
+    """Parse an alert condition and check it against the supported grammar.
+
+    Examples: ``cpu_usage > threshold``, ``0 < response_time <= 5``,
+    ``error_rate >= threshold and cpu_usage > 50``. Calls, attributes,
+    subscripts, arithmetic, strings, booleans and all other constructs raise
+    UnsupportedConditionError.
+    """
+    if not isinstance(condition, str) or not condition.strip():
+        raise UnsupportedConditionError("an alert condition must be a non-empty string")
+    if len(condition) > MAX_CONDITION_LENGTH:
+        raise UnsupportedConditionError(
+            f"an alert condition has at most {MAX_CONDITION_LENGTH} characters"
+        )
+    try:
+        tree = ast.parse(condition.strip(), mode="eval")
+    except SyntaxError as exc:
+        raise UnsupportedConditionError(f"invalid alert condition {condition!r}") from exc
+    _check_condition(tree.body, condition)
+    return tree.body
+
+
+def _check_condition(node: ast.expr, condition: str) -> None:
+    if isinstance(node, ast.BoolOp) and isinstance(node.op, (ast.And, ast.Or)):
+        for value in node.values:
+            _check_condition(value, condition)
+        return
+    if isinstance(node, ast.Compare):
+        if not all(type(op) in _COMPARISONS for op in node.ops):
+            raise UnsupportedConditionError(f"unsupported comparison in {condition!r}")
+        for operand in (node.left, *node.comparators):
