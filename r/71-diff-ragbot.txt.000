             Cache key
         """
         import hashlib
-        text_hash = hashlib.md5(text.encode()).hexdigest()
+        # Security: SHA-256. These keys name entries of a cache that every
+        # tenant shares; with MD5, a crafted text could collide with another
+        # text and receive its cached value.
+        text_hash = hashlib.sha256(text.encode("utf-8")).hexdigest()
         return f"embedding:{model}:{text_hash}"
     
     @staticmethod
@@ -242,7 +245,7 @@ class CacheKey:
             Cache key
         """
         import hashlib
-        question_hash = hashlib.md5(question.encode()).hexdigest()
+        question_hash = hashlib.sha256(question.encode("utf-8")).hexdigest()  # see embedding()
         return f"query:{model}:{lang}:{question_hash}:{context_hash}"
     
     @staticmethod
@@ -259,7 +262,7 @@ class CacheKey:
