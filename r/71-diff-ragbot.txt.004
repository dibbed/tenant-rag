+    entries = data["documents"]
+    if not isinstance(entries, list):
+        raise DocumentFileError(f"{path}: 'documents' is not a list", path)
+    total = int(values.shape[0])
+    documents: dict[str, VectorDocument] = {}
+    for index, entry in enumerate(entries):
+        where = f"{path}: document {index}"
+        if not isinstance(entry, dict) or set(entry) != _FIELDS:
+            raise DocumentFileError(f"{where} does not have exactly the fields {sorted(_FIELDS)}", path)
+        key = entry["key"]
+        doc_id = entry["id"]
+        content = entry["content"]
+        metadata = entry["metadata"]
+        score = entry["score"]
+        embedding = entry["embedding"]
+        if not isinstance(key, str) or not key:
+            raise DocumentFileError(f"{where}: 'key' is not a non-empty string", path)
+        if key in documents:
+            raise DocumentFileError(f"{where}: the key {key!r} is not unique", path)
+        if not isinstance(doc_id, str) or not doc_id:
+            raise DocumentFileError(f"{where}: 'id' is not a non-empty string", path)
+        if not isinstance(content, str):
+            raise DocumentFileError(f"{where}: 'content' is not a string", path)
+        if not isinstance(metadata, dict):
+            raise DocumentFileError(f"{where}: 'metadata' is not an object", path)
+        if score is not None and (isinstance(score, bool) or not isinstance(score, (int, float))):
+            raise DocumentFileError(f"{where}: 'score' is not a number", path)
+        if (
+            not isinstance(embedding, list)
+            or len(embedding) != 2
+            or not all(type(number) is int and number >= 0 for number in embedding)
+            or embedding[0] + embedding[1] > total
+        ):
+            raise DocumentFileError(f"{where}: 'embedding' is not a valid [offset, length] pair", path)
+        start, length = embedding
+        try:
+            documents[key] = VectorDocument(
+                id=doc_id,
+                content=content,
+                embedding=values[start : start + length].tolist(),
+                metadata=metadata,
+                score=score,
+            )
+        except ValueError as exc:
+            raise DocumentFileError(f"{where}: {exc}", path) from exc
+    return documents
