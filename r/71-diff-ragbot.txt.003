                 cached_results.append((uncached_indices[i], embedding))
 
@@ -115,7 +125,7 @@ class STEmbedder(BaseEmbedder):
             uncached_indices = []
 
             for i, text in enumerate(texts):
-                text_hash = hashlib.md5(text.encode()).hexdigest()
+                text_hash = _embedding_cache_key(text)
                 if text_hash in self._cache:
                     cached_results.append((i, self._cache[text_hash]))
                 else:
@@ -137,7 +147,7 @@ class STEmbedder(BaseEmbedder):
